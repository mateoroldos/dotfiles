#!/usr/bin/env bash
# Open repos and their jj workspaces (forks) in herdr. The jj aliases ws-add and ws-remove own
# the workspaces; this script adds the picker, the prompts, and the herdr views. Runs in a herdr popup, so it reads the
# focused pane from HERDR_ACTIVE_* and never types commands into your shell.
set -euo pipefail

usage() {
  echo "usage: jj-ws new tab|workspace | jj-ws open | jj-ws rows [all|repo|fork] | jj-ws preview|fork <dir> | jj-ws rm [dir]" >&2
  exit 2
}

# The popup closes when the script exits, so hold errors on screen.
die() {
  echo "$*" >&2
  read -r -p "Press enter to close." _ || true
  exit 1
}

focused_dir() {
  local cwd="${HERDR_ACTIVE_PANE_CWD:-${PWD}}"

  (cd "${cwd}" && jj root >/dev/null 2>&1) || die "Not in a jj repo: ${cwd}"
  echo "${cwd}"
}

repo_name() {
  basename "$(jj workspace root --name default)"
}

random_name() {
  local adjectives=(brave calm clear green lucky quiet rapid silver)
  local nouns=(river cloud field forest harbor meadow stone valley)

  echo "${adjectives[RANDOM % ${#adjectives[@]}]}-${nouns[RANDOM % ${#nouns[@]}]}"
}

# Opens cwd as a tab or a herdr workspace: a shell on the left, and jjui on the right in a jj repo.
open_view() {
  local mode="$1" label="$2" cwd="$3"
  local created jjui_pane

  case "${mode}" in
    tab)
      created="$(herdr tab create --workspace "${HERDR_ACTIVE_WORKSPACE_ID:?run jj-ws from herdr}" \
        --cwd "${cwd}" --label "${label}" --focus)"
      ;;
    workspace)
      created="$(herdr workspace create --cwd "${cwd}" --label "${label}" --focus)"
      ;;
  esac

  if [[ -e "${cwd}/.jj" ]]; then
    jjui_pane="$(herdr pane split "$(jq -r .result.root_pane.pane_id <<<"${created}")" \
      --direction right --cwd "${cwd}" | jq -r .result.pane.pane_id)"
    herdr pane run "${jjui_pane}" jjui >/dev/null
  fi
}

# Prints the tab of the first herdr pane working inside root, if any.
open_tab_of() {
  local root="$1"

  herdr pane list | jq -r --arg root "${root}" '
    .result.panes[]
    | select([.cwd, .foreground_cwd] | any((. // "") as $cwd
        | $cwd == $root or ($cwd | startswith($root + "/"))))
    | .tab_id' | head -n 1
}

# Prints "tab <id>" or "workspace <id>" for each herdr view working inside
# root: the whole workspace when all its tabs are inside, else each tab. The
# view behind the popup comes last, so closing it can't cut the loop short.
views_inside() {
  local root="$1"

  { herdr tab list; herdr pane list; } | jq -rs --arg root "${root}" \
    --arg active_workspace "${HERDR_ACTIVE_WORKSPACE_ID:-}" \
    --arg active_tab "${HERDR_ACTIVE_TAB_ID:-}" '
    def inside: (. // "") as $cwd | $cwd == $root or ($cwd | startswith($root + "/"));
    (.[1].result.panes | map(select([.cwd, .foreground_cwd] | any(inside)) | .tab_id)) as $hit
    | .[0].result.tabs
    | group_by(.workspace_id)
    | map(map(.tab_id) as $tabs
        | if ($tabs - $hit) == [] then [{kind: "workspace", id: .[0].workspace_id}]
          else [$tabs[] | select(IN($hit[])) | {kind: "tab", id: .}] end)
    | add // []
    | sort_by(.id == $active_workspace or .id == $active_tab)
    | .[] | "\(.kind) \(.id)"'
}

cmd_new() {
  local mode="$1"
  local repo name destination

  [[ "${mode}" == tab || "${mode}" == workspace ]] || usage

  cd "$(focused_dir)"
  repo="$(repo_name)"

  read -r -e -i "$(random_name)" -p "New workspace in ${repo}: " name
  destination="$(jj ws-add "${name}")" || die "Could not create the jj workspace."

  if [[ "${mode}" == tab ]]; then
    open_view tab "${name}" "${destination}"
  else
    open_view workspace "${repo}/${name}" "${destination}"
  fi
}

# Exits 0 when a herdr pane works in dir or below it.
is_open() {
  local dir="$1" open_cwds="$2"

  awk -v dir="${dir}" '
    index($0, dir) == 1 && (length($0) == length(dir) || substr($0, length(dir) + 1, 1) == "/") { found = 1 }
    END { exit !found }' <<<"${open_cwds}"
}

# Prints one row with its path last, where the tv channel reads it. ● marks what herdr has open.
# width is the visible width of indent and label; path_style is an SGR code, 8 hides the path.
print_row() {
  local indent="$1" label="$2" width="$3" path="$4" path_style="$5" open_cwds="$6"
  local mark=" "

  if is_open "${path}" "${open_cwds}"; then
    mark=$'\e[33m●\e[0m'
  fi

  printf '%s%s %s%*s  \e[%sm%s\e[0m\n' "${indent}" "${mark}" "${label}" "$((width < 32 ? 32 - width : 1))" "" \
    "${path_style}" "${path/#${HOME}/\~}"
}

# Prints a row for each repo zoxide knows, most used first, with its forks indented below.
# kind is all, repo, or fork; the fork list is flat and names each fork's repo.
cmd_rows() {
  local kind="${1:-all}"
  local open_cwds dir repo forks index glyph name root

  open_cwds="$(herdr pane list 2>/dev/null | jq -r '.result.panes[] | .cwd, (.foreground_cwd // empty)')"

  zoxide query -l | while read -r dir; do
    # A main jj workspace holds its store in .jj/repo; a git-only repo has a .git directory.
    [[ -d "${dir}/.jj/repo" || (-d "${dir}/.git" && ! -e "${dir}/.jj") ]] || continue
    repo="$(basename "${dir}")"

    if [[ "${kind}" != fork ]]; then
      print_row "" $'\e[1m'"${repo}"$'\e[0m' "${#repo}" "${dir}" 2 "${open_cwds}"
    fi

    [[ "${kind}" != repo && -d "${dir}/.jj/repo" ]] || continue
    mapfile -t forks < <(jj --ignore-working-copy -R "${dir}" workspace list -T 'name ++ "\t" ++ root ++ "\n"' |
      awk -F '\t' '$1 != "default" && system("test -d \"" $2 "\"") == 0')

    for index in "${!forks[@]}"; do
      IFS=$'\t' read -r name root <<<"${forks[index]}"

      if [[ "${kind}" == fork ]]; then
        print_row "" $'\e[2m'"${repo}/"$'\e[0m'"${name}" "$((${#repo} + 1 + ${#name}))" "${root}" 2 "${open_cwds}"
      else
        glyph="├"
        if ((index == ${#forks[@]} - 1)); then
          glyph="└"
        fi
        print_row "  ${glyph} " "${name}" 0 "${root}" 8 "${open_cwds}"
      fi
    done
  done
}

# Shows what a repo or fork holds beyond trunk.
cmd_preview() {
  local dir="${1/#\~/${HOME}}"

  if [[ -e "${dir}/.jj" ]]; then
    jj --ignore-working-copy -R "${dir}" log --color=always -r 'trunk() | trunk()..@'
  else
    git -C "${dir}" log --oneline --color=always -15
  fi
}

cmd_fork() {
  local dir="${1/#\~/${HOME}}"
  local root repo name destination

  [[ -e "${dir}/.jj" ]] || die "Forks need a jj repo: ${dir}"
  root="$(jj --ignore-working-copy -R "${dir}" workspace root --name default)"
  repo="$(basename "${root}")"
  cd "${root}"

  read -r -e -i "$(random_name)" -p "New fork of ${repo}: " name
  destination="$(jj ws-add "${name}")" || die "Could not create the fork."

  open_view workspace "${repo}/${name}" "${destination}"
}

cmd_open() {
  local path tab root label

  path="$(tv projects)" || exit 0
  [[ -n "${path}" ]] || exit 0
  path="${path/#\~/${HOME}}"

  tab="$(open_tab_of "${path}")"
  if [[ -n "${tab}" ]]; then
    herdr tab focus "${tab}" >/dev/null
    return
  fi

  label="$(basename "${path}")"
  if [[ -f "${path}/.jj/repo" ]]; then
    root="$(jj --ignore-working-copy -R "${path}" workspace root --name default)"
    label="$(basename "${root}")/${label}"
  fi

  open_view workspace "${label}" "${path}"
}

cmd_rm() {
  local dir="${1:-$(focused_dir)}"
  local root views kind id

  cd "${dir/#\~/${HOME}}"
  root="$(realpath "$(jj root)")"
  [[ ! -d "${root}/.jj/repo" ]] || die "Only forks can be deleted: ${root} holds the repo."
  views="$(views_inside "${root}")"

  jj ws-remove || die "Workspace kept."
  cd /

  while read -r kind id; do
    if [[ -n "${kind}" ]]; then
      herdr "${kind}" close "${id}" >/dev/null
    fi
  done <<<"${views}"
}

case "${1:-}" in
  new)
    [[ $# -eq 2 ]] || usage
    cmd_new "$2"
    ;;
  open)
    [[ $# -eq 1 ]] || usage
    cmd_open
    ;;
  rows)
    [[ $# -le 2 ]] || usage
    cmd_rows "${2:-all}"
    ;;
  preview | fork)
    [[ $# -eq 2 ]] || usage
    "cmd_$1" "$2"
    ;;
  rm)
    [[ $# -le 2 ]] || usage
    cmd_rm "${2:-}"
    ;;
  *) usage ;;
esac
