{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "websearch": {
    "provider": "exa"
  },
  "references": {
    "oss": {
      "path": "/Code",
      "description": "Local open-source repositories used for implementation research"
    },
    "projects": {
      "path": "~/Projects",
      "description": "Active personal projects and experiments"
    }
  },
  "plugin": [
    "@plannotator/opencode@latest"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5": {
          "variants": {
            "default": {
              "textVerbosity": "low"
            }
          }
        }
      }
    }
  }
}
