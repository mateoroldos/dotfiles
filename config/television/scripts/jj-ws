#!/usr/bin/env bash
# Open repos and their jj workspaces (forks) in herdr-app. The jj aliases ws-add and ws-remove own
# the workspaces; this script adds the picker, the prompts, and the herdr-app views. herdr-app keys
# start it in its own tab, in the focused terminal's folder, and it closes that tab when done.
set -euo pipefail

usage() {
  echo "usage: jj-ws new tab|space | jj-ws open | jj-ws rows [all|repo|fork] | jj-ws preview|fork <dir> | jj-ws rm [dir]" >&2
  exit 2
}

# The tab stays after the script exits, so hold errors on screen, then close it.
die() {
  echo "$*" >&2
  read -r -p "Press enter to close." _ || true
  exit 1
}

focused_dir() {
  local cwd="${PWD}"

  (cd "${cwd}" && jj root >/dev/null 2>&1) || die "Not in a jj repo: ${cwd}"
  echo "${cwd}"
}

repo_name() {
  basename "$(jj workspace root --name default)"
}

random_name() {
  local adjectives=(brave calm clear green lucky quiet rapid silver)
  local nouns=(river cloud field forest harbor meadow stone valley)

  echo "${adjectives[RANDOM % ${#adjectives[@]}]}-${nouns[RANDOM % ${#nouns[@]}]}"
}

# Opens cwd as a tab or a herdr-app space: a shell on the left, and jjui on the right in a jj repo.
open_view() {
  local mode="$1" label="$2" cwd="$3"

  herdr-app do "${mode}.new" --name "${label}" --folder "${cwd}" >/dev/null

  if [[ -e "${cwd}/.jj" ]]; then
    herdr-app do pane.split --direction right --argv '["jjui"]' >/dev/null
  fi
}

# Prints one JSON array of this computer's terminals: their space, tab and folder.
terminals() {
  jq -n --argjson ls "$(herdr-app ls)" --argjson hc "$(hc ls --json)" '
    ($hc.terminals | map(select(.address | contains("/") | not) | {(.address): .cwd}) | add // {}) as $cwd
    | [$ls.spaces[] | .id as $space | .tabs[] | .id as $tab | .terminals[]
        | select($cwd[.terminal]) | {space: $space, tab: $tab, terminal, cwd: $cwd[.terminal]}]'
}

# Prints the tab of the first terminal working inside root, other than this script's, if any.
open_tab_of() {
  local root="$1"

  terminals | jq -r --arg root "${root}" --arg self "${HC_TERMINAL_ID:-}" '
    map(select(.terminal != $self and (.cwd == $root or (.cwd | startswith($root + "/")))))
    | .[0].tab // empty'
}

# Prints "tab <id>" or "space <id>" for each herdr-app view working inside root:
# the whole space when all its tabs are inside, else each tab. This script's own
# tab is left for the exit to close, and its space comes last.
views_inside() {
  local root="$1"

  terminals | jq -r --arg root "${root}" --arg self "${HC_TERMINAL_ID:-}" '
    (map(select(.terminal == $self)) | .[0] // {}) as $me
    | map(select(.tab != $me.tab))
    | (map(select(.cwd == $root or (.cwd | startswith($root + "/"))) | .tab)) as $hit
    | group_by(.space)
    | map((map(.tab) | unique) as $tabs
        | if ($tabs - $hit) == [] then [{kind: "space", id: .[0].space}]
          else [$tabs[] | select(IN($hit[])) | {kind: "tab", id: .}] end)
    | add // []
    | sort_by(.id == $me.space)
    | .[] | "\(.kind) \(.id)"'
}

# Closes the tab herdr-app started this script in.
close_own_tab() {
  local tab

  tab="$(herdr-app ls | jq -r --arg self "${HC_TERMINAL_ID:-}" \
    '.spaces[].tabs[] | select(any(.terminals[]; .terminal == $self)) | .id')"

  if [[ -n "${tab}" ]]; then
    herdr-app do tab.close --id "${tab}" >/dev/null
  fi
}

cmd_new() {
  local mode="$1"
  local repo name destination

  [[ "${mode}" == tab || "${mode}" == space ]] || usage

  cd "$(focused_dir)"
  repo="$(repo_name)"

  read -r -e -i "$(random_name)" -p "New workspace in ${repo}: " name
  destination="$(jj ws-add "${name}")" || die "Could not create the jj workspace."

  if [[ "${mode}" == tab ]]; then
    open_view tab "${name}" "${destination}"
  else
    open_view space "${repo}/${name}" "${destination}"
  fi
}

# Exits 0 when a terminal works in dir or below it.
is_open() {
  local dir="$1" open_cwds="$2"

  awk -v dir="${dir}" '
    index($0, dir) == 1 && (length($0) == length(dir) || substr($0, length(dir) + 1, 1) == "/") { found = 1 }
    END { exit !found }' <<<"${open_cwds}"
}

# Prints one row with its path last, where the tv channel reads it. ● marks what herdr-app has open.
# width is the visible width of indent and label; path_style is an SGR code, 8 hides the path.
print_row() {
  local indent="$1" label="$2" width="$3" path="$4" path_style="$5" open_cwds="$6"
  local mark=" "

  if is_open "${path}" "${open_cwds}"; then
    mark=$'\e[33m●\e[0m'
  fi

  printf '%s%s %s%*s  \e[%sm%s\e[0m\n' "${indent}" "${mark}" "${label}" "$((width < 32 ? 32 - width : 1))" "" \
    "${path_style}" "${path/#${HOME}/\~}"
}

# Prints a row for each repo zoxide knows, most used first, with its forks indented below.
# kind is all, repo, or fork; the fork list is flat and names each fork's repo.
cmd_rows() {
  local kind="${1:-all}"
  local open_cwds dir repo forks index glyph name root

  open_cwds="$(terminals 2>/dev/null | jq -r '.[].cwd')"

  zoxide query -l | while read -r dir; do
    # A main jj workspace holds its store in .jj/repo; a git-only repo has a .git directory.
    [[ -d "${dir}/.jj/repo" || (-d "${dir}/.git" && ! -e "${dir}/.jj") ]] || continue
    repo="$(basename "${dir}")"

    if [[ "${kind}" != fork ]]; then
      print_row "" $'\e[1m'"${repo}"$'\e[0m' "${#repo}" "${dir}" 2 "${open_cwds}"
    fi

    [[ "${kind}" != repo && -d "${dir}/.jj/repo" ]] || continue
    mapfile -t forks < <(jj --ignore-working-copy -R "${dir}" workspace list -T 'name ++ "\t" ++ root ++ "\n"' |
      awk -F '\t' '$1 != "default" && system("test -d \"" $2 "\"") == 0')

    for index in "${!forks[@]}"; do
      IFS=$'\t' read -r name root <<<"${forks[index]}"

      if [[ "${kind}" == fork ]]; then
        print_row "" $'\e[2m'"${repo}/"$'\e[0m'"${name}" "$((${#repo} + 1 + ${#name}))" "${root}" 2 "${open_cwds}"
      else
        glyph="├"
        if ((index == ${#forks[@]} - 1)); then
          glyph="└"
        fi
        print_row "  ${glyph} " "${name}" 0 "${root}" 8 "${open_cwds}"
      fi
    done
  done
}

# Shows what a repo or fork holds beyond trunk.
cmd_preview() {
  local dir="${1/#\~/${HOME}}"

  if [[ -e "${dir}/.jj" ]]; then
    jj --ignore-working-copy -R "${dir}" log --color=always -r 'trunk() | trunk()..@'
  else
    git -C "${dir}" log --oneline --color=always -15
  fi
}

cmd_fork() {
  local dir="${1/#\~/${HOME}}"
  local root repo name destination

  [[ -e "${dir}/.jj" ]] || die "Forks need a jj repo: ${dir}"
  root="$(jj --ignore-working-copy -R "${dir}" workspace root --name default)"
  repo="$(basename "${root}")"
  cd "${root}"

  read -r -e -i "$(random_name)" -p "New fork of ${repo}: " name
  destination="$(jj ws-add "${name}")" || die "Could not create the fork."

  open_view space "${repo}/${name}" "${destination}"
}

cmd_open() {
  local path tab root label

  path="$(tv projects)" || exit 0
  [[ -n "${path}" ]] || exit 0
  path="${path/#\~/${HOME}}"

  tab="$(open_tab_of "${path}")"
  if [[ -n "${tab}" ]]; then
    herdr-app do tab.select --id "${tab}" >/dev/null
    return
  fi

  label="$(basename "${path}")"
  if [[ -f "${path}/.jj/repo" ]]; then
    root="$(jj --ignore-working-copy -R "${path}" workspace root --name default)"
    label="$(basename "${root}")/${label}"
  fi

  open_view space "${label}" "${path}"
}

cmd_rm() {
  local dir="${1:-$(focused_dir)}"
  local root views kind id

  cd "${dir/#\~/${HOME}}"
  root="$(realpath "$(jj root)")"
  [[ ! -d "${root}/.jj/repo" ]] || die "Only forks can be deleted: ${root} holds the repo."
  views="$(views_inside "${root}")"

  jj ws-remove || die "Workspace kept."
  cd /

  while read -r kind id; do
    if [[ -n "${kind}" ]]; then
      herdr-app do "${kind}.close" --id "${id}" --confirmed true >/dev/null
    fi
  done <<<"${views}"
}

# Run from a herdr-app key, the script owns its tab; run by tv, it doesn't.
if [[ "${1:-}" == new || "${1:-}" == open || ("${1:-}" == rm && $# -eq 1) ]]; then
  trap close_own_tab EXIT
fi

case "${1:-}" in
  new)
    [[ $# -eq 2 ]] || usage
    cmd_new "$2"
    ;;
  open)
    [[ $# -eq 1 ]] || usage
    cmd_open
    ;;
  rows)
    [[ $# -le 2 ]] || usage
    cmd_rows "${2:-all}"
    ;;
  preview | fork)
    [[ $# -eq 2 ]] || usage
    "cmd_$1" "$2"
    ;;
  rm)
    [[ $# -le 2 ]] || usage
    cmd_rm "${2:-}"
    ;;
  *) usage ;;
esac
